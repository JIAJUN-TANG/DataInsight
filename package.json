{
  "name": "datainsight",
  "private": true,
  "version": "0.1.1-alpha",
  "main": "main.js",
  "type": "module",
  "author": "JIAJUN-TANG",
  "description": "A comprehensive data science platform for analyzing data with automated statistics, interactive visualizations, and powerful AI insights.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder",
    "dev:electron": "concurrently \"npm run dev\" \"npm run electron:dev\"",
    "build:clean": "rimraf dist release"
  },
  "build": {
    "appId": "com.datainsight.app",
    "productName": "DataInsight",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js"
    ],
    "asar": false,
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JIAJUN-TANG",
        "repo": "DataInsight"
      }
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.555.0",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.0",
    "segment": "^0.1.3",
    "sql.js": "1.11.0",
    "tailwindcss": "^4.1.17",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
